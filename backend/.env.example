# Copy to .env and fill in. Never commit .env — it's gitignored.
# Every var here maps to a field on Settings in config.py.

# --- Database ---------------------------------------------------------------
# Ignored when running via docker compose (overridden to point at the db
# container). Required for a bare `uvicorn` run.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leetcode_review

# --- Auth (Clerk) -----------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxx
# Optional: PEM public key for offline JWT verification (skips a network hop)
CLERK_JWT_KEY=
# Comma-separated. Must include your frontend origin or auth silently fails.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- CORS / URLs ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Payments (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs have defaults in config.py; override only if they change.
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_ANNUAL=
# STRIPE_PRICE_LIFETIME=
# STRIPE_PRICE_TRIAL=
# STRIPE_TRIAL_ID=

# --- AI (Anthropic) ---------------------------------------------------------
# Powers the tutor, interviewer, and flashcard generation. Set a spend limit
# on the workspace — these endpoints are not yet rate limited.
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=re_xxx

# --- Cron / tokens ----------------------------------------------------------
# Shared secret for POST /notify/daily auth AND for signing unsubscribe and
# calendar-feed tokens. Generate with: openssl rand -hex 32
NOTIFY_SECRET=change_me

# --- Code execution (optional) ----------------------------------------------
# RapidAPI key for Judge0. If unset, POST /execute returns 503.
JUDGE0_API_KEY=
